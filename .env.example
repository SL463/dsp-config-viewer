# --- Storage (Vercel Blob) ---
# Create a Blob store in the Vercel dashboard (Storage tab) and paste its
# read/write token here. Without it, the app stores tunes locally under .data/.
BLOB_READ_WRITE_TOKEN=

# Auth is intentionally not configured — /upload and /admin are open for now.
# Wire Vercel Authentication (or another provider) when you're ready.
