# --- Storage (Vercel Blob) ---
# Create a Blob store in the Vercel dashboard (Storage tab) and paste its
# read/write token here. Without it, the app stores tunes locally under .data/.
BLOB_READ_WRITE_TOKEN=

# --- Admin auth (protects /upload and /admin) ---
# Set all three. If username or password is missing, login is disabled.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Long random string used to sign the session cookie, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
